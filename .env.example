# --- Client-side (safe to expose, must be prefixed VITE_ so Vite bundles them into the browser) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- Server-side only (set these in Vercel Project Settings > Environment Variables,
#     NEVER put them in .env files that ship to the client or get committed to git) ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_WEBHOOK_SECRET=choose-a-random-string
APP_URL=https://your-app.vercel.app
